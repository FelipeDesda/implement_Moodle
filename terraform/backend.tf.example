# ==============================================================================
# Backend Configuration - Terraform State (S3 + DynamoDB)
# ==============================================================================
# Renomeie este arquivo para backend.tf para habilitar o backend remoto
# 
# IMPORTANTE: 
# - Crie o bucket S3 e tabela DynamoDB ANTES de habilitar este backend
# - Execute: terraform init -migrate-state (para migrar state local para S3)
# ==============================================================================

# Descomente o bloco abaixo após criar os recursos necessários

# terraform {
#   backend "s3" {
#     bucket         = "moodle-terraform-state-ACCOUNT_ID"  # Altere ACCOUNT_ID
#     key            = "moodle/terraform.tfstate"
#     region         = "us-east-1"
#     encrypt        = true
#     dynamodb_table = "moodle-terraform-locks"
#   }
# }

# ------------------------------------------------------------------------------
# Comandos para criar os recursos do backend (execute uma única vez):
# ------------------------------------------------------------------------------

# 1. Criar bucket S3:
# aws s3api create-bucket \
#   --bucket moodle-terraform-state-$(aws sts get-caller-identity --query Account --output text) \
#   --region us-east-1

# 2. Habilitar versionamento:
# aws s3api put-bucket-versioning \
#   --bucket moodle-terraform-state-$(aws sts get-caller-identity --query Account --output text) \
#   --versioning-configuration Status=Enabled

# 3. Habilitar criptografia:
# aws s3api put-bucket-encryption \
#   --bucket moodle-terraform-state-$(aws sts get-caller-identity --query Account --output text) \
#   --server-side-encryption-configuration '{
#     "Rules": [{"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]
#   }'

# 4. Criar tabela DynamoDB para locks:
# aws dynamodb create-table \
#   --table-name moodle-terraform-locks \
#   --attribute-definitions AttributeName=LockID,AttributeType=S \
#   --key-schema AttributeName=LockID,KeyType=HASH \
#   --billing-mode PAY_PER_REQUEST \
#   --region us-east-1
