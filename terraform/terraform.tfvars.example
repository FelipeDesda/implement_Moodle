# ==============================================================================
# Terraform Variables - Example Configuration
# ==============================================================================
# Copie este arquivo para terraform.tfvars e ajuste os valores conforme necessário
# NUNCA commite o arquivo terraform.tfvars (já está no .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------

aws_region   = "us-east-1"
environment  = "dev"
project_name = "moodle"

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------

vpc_cidr                = "10.0.0.0/16"
public_subnet_cidr      = "10.0.1.0/24"
private_subnet_a_cidr   = "10.0.2.0/24"
private_subnet_b_cidr   = "10.0.3.0/24"
availability_zone_a     = "us-east-1a"
availability_zone_b     = "us-east-1b"

# ------------------------------------------------------------------------------
# Compute (EC2)
# ------------------------------------------------------------------------------

ec2_instance_type = "t3.medium"
ec2_key_name      = "vockey"

# IMPORTANTE: Restrinja ao seu IP para maior segurança
# Obtenha seu IP: curl -s ifconfig.me
ssh_allowed_cidr  = "0.0.0.0/0"  # ⚠️ ALTERE PARA SEU IP/32

# ------------------------------------------------------------------------------
# Database (RDS)
# ------------------------------------------------------------------------------

db_instance_class    = "db.t3.micro"
db_name              = "moodle"
db_username          = "moodleuser"
db_password          = "ChangeMeToSecurePassword123!"  # ⚠️ ALTERE ESTA SENHA
db_allocated_storage = 20
